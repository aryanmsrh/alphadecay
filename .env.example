# --- API Keys & Remote Endpoints ---
# Tavily AI Search API Key (Free tier: 1000 searches/mo at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key & Model (Free tier: 15 RPM at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=HIGH

# --- Local Ollama Settings (Fallback Only) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FALLBACK_MODEL=deepseek-r1:7b

# --- Operational Toggles ---
# Set to True to force 100% offline local Ollama execution (fallback resilience test)
USE_OFFLINE_MODE=false

# Reproducible investigation cutoff date (YYYY-MM-DD); leave empty to use latest available filings
INVESTIGATION_CUTOFF_DATE=

# Investigation budget (max anomalies to evaluate before synthesis)
MAX_ANOMALIES_TO_INVESTIGATE=2
